{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
     "jsx": "react-jsx",
    "strict": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/api/*": [
        "./src/api/*"
      ],
      "@/constants/*": [
        "./src/constants/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
, "plugins/withPlugin.js"  ]
}
